# ── Shopify Storefront API (products, cart, checkout) ──────────────────────
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# ── Neon Postgres (site content, menus, stories, image library) ────────────
# Use the *pooled* connection string from the Neon console (host contains "-pooler").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Neon Auth (admin sign-in) ──────────────────────────────────────────────
# Neon console → your project → Auth → enable, then copy the Auth URL.
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth
# Any random string of at least 32 characters, e.g. `openssl rand -base64 32`
NEON_AUTH_COOKIE_SECRET=

# ── Vercel Blob (uploaded images) ──────────────────────────────────────────
# Vercel → Storage → create a Blob store and connect it to the project.
# Production uses BLOB_STORE_ID + OIDC automatically; BLOB_READ_WRITE_TOKEN is optional.
BLOB_READ_WRITE_TOKEN=

# Public address of the site (used for canonical links and social previews).
NEXT_PUBLIC_SITE_URL=https://www.italianpantry.ca

# ── Contact form (Cloudflare Turnstile + AWS SES SMTP) ─────────────────────
# Turnstile: Cloudflare dashboard → Turnstile → create widget (managed recommended).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SES: AWS console → SES → SMTP settings (create SMTP credentials).
# Use the regional endpoint host, e.g. email-smtp.ca-central-1.amazonaws.com
SMTP_HOST=email-smtp.ca-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# From address must be a verified identity/domain in SES.
CONTACT_MAIL_FROM=hello@italianpantry.ca
CONTACT_MAIL_TO=orders@italianpantry.com

# ── Local development only ─────────────────────────────────────────────────
# Preview with sample products before Shopify is connected. Never in production.
SHOPIFY_DEMO_MODE=false
# Lets you sign in locally without Neon Auth (only works when NEON_AUTH_* is unset).
# The email must have role `admin` in neon_auth.user. Never set this in production.
ADMIN_DEV_PASSWORD=
